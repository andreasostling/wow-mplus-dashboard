# Warcraft Logs v2 API credentials
# Create a client at: https://www.warcraftlogs.com/api/clients/
#   - Name:         anything (e.g. "ClaudeLogger")
#   - Redirect URL: https://localhost  (unused for client-credentials flow, but required by the form)
# Then copy this file to .env and paste the generated values.

WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# --- Optional defaults ---
# The character we discover reports from.
WCL_CHARACTER_ID=109774647

# Which MythicDungeonTools expansion folder to ingest for curated interrupt facts
# (must match a top-level folder in the MDT GitHub repo). Defaults to Midnight.
# CLAUDELOGGER_MDT_EXPANSION=Midnight
